      "bookSourceType": 1,
      "enable": true,
      "bookSourceLang": "zh-Hans",
      "httpUserAgent": "Mozilla/5.0 (Linux; Android 13) AppleWebKit/537.36 Chrome/139 Mobile Safari/537.36",
      "header": "Referer:https://m.wmh1234.com/",
      "searchUrl": "https://m.wmh1234.com/search?key={{key}}",
      "healthCheckQuery": "三生三世十里桃花",
      "popularUrl": "https://m.wmh1234.com/",
      "contentUrl": "https://reader.hqread.cc/r/{{pathAfter:/go/}}",
      "allowedImageHosts": [
        "wmh1234.wszwhg.net"
      ],
      "ruleSearch": {
        "itemList": "body:has(#searchInput) section.container > .comic-grid > article.comic-card, body:not(:has(#searchInput)) article.comic-card",
        "itemName": "h3.comic-card__title",
        "itemUrl": "a.comic-card__link@href",
        "itemCover": "img.comic-card__image@data-src"
      },
      "ruleBookInfo": {
        "name": "#mintWorkTitle",
        "cover": "#mintWorkCover@src",
        "author": ".mint-work-info p:first-of-type",
        "status": ".mint-work-info .mint-tag",
        "description": "meta[property='og:description']@content"
      },
      "ruleChapter": {
        "chapterList": ".mint-chapter-grid a[href^='/go/'], .mint-chapter-grid a[href^='/comic/']",
        "chapterName": "text()",
        "chapterUrl": "@href",
        "reverse": true
      },
      "ruleContent": {
        "imageList": "main[data-mint-reader] img.reader-image[data-src]@data-src"
      }
    },
    {
      "bookSourceName": "LINE WEBTOON（繁體中文）",
      "bookSourceKey": "aurora.zh.webtoons.zh-hant",
