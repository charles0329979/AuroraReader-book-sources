      "bookSourceUrl": "https://www.dongmanmanhua.cn",
      "bookSourceType": 1,
      "enable": true,
      "bookSourceLang": "zh-Hans",
      "httpUserAgent": "Mozilla/5.0 (Linux; Android 13) AppleWebKit/537.36 Chrome/139 Mobile Safari/537.36",
      "header": "Referer:https://www.dongmanmanhua.cn/",
      "searchUrl": "https://www.dongmanmanhua.cn/search?keyword={{key}}&page={{page}}",
      "popularUrl": "https://www.dongmanmanhua.cn/dailySchedule",
      "latestUrl": "https://www.dongmanmanhua.cn/dailySchedule?sortOrder=UPDATE&webtoonCompleteType=ONGOING",
      "allowedImageHosts": [
        "cdn.dongmanmanhua.cn"
      ],
      "ruleSearch": {
        "itemList": "#content .card_wrap.search ul.card_lst li a[href^='/episodeList?']",
        "itemName": "p.subj",
        "itemUrl": "@href",
        "itemCover": "img@src"
      },
      "ruleBookInfo": {
        "name": ".detail_header h1.subj",
        "cover": ".detail_header .thmb img@src",
        "author": ".detail_header .info .author",
        "genre": ".detail_header .info .genre",
        "description": "#_asideDetail p.summary"
      },
      "ruleChapter": {
        "chapterList": "ul#_listUl li > a[href*='/viewer?']",
        "chapterName": "span.subj span",
        "chapterUrl": "@href",
        "reverse": true,
        "nextPageSelector": "div.paginate a[onclick] + a[href]",
        "maxIndexPages": 200
      },
      "ruleContent": {
        "imageList": "#_imageList img[data-url]@data-url"
      },
      "healthCheckQuery": "非人哉"
    }
  ]
