      "bookSourceType": 1,
      "enable": true,
      "bookSourceLang": "zh-Hant",
      "httpUserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/139.0 Safari/537.36",
      "header": "Referer:https://www.webtoons.com/",
      "searchUrl": "https://www.webtoons.com/zh-hant/search?keyword={{key}}",
      "popularUrl": "https://www.webtoons.com/zh-hant/ranking/trending",
      "chaptersUrl": "https://m.webtoons.com/api/v1/webtoon/{{query:title_no}}/episodes?pageSize=99999",
      "allowedImageHosts": [
        "webtoon-phinf.pstatic.net"
      ],
      "ruleSearch": {
        "itemList": ".webtoon_list li a[href*='/list?title_no=']",
        "itemName": ".title",
        "itemUrl": "@href",
        "itemCover": "img@src"
      },
      "ruleBookInfo": {
        "name": ".detail_header h1.subj",
        "cover": ".detail_header .thmb img@src",
        "author": ".detail_header .info .author_area",
        "genre": ".detail_header .info .genre",
        "description": "#_asideDetail p.summary"
      },
      "ruleChapter": {
        "chapterList": "$.result.episodeList",
        "chapterName": "$.episodeTitle",
        "chapterUrl": "$.viewerLink"
      },
      "ruleContent": {
        "imageList": "#_imageList > img[data-url]@data-url"
      },
      "healthCheckQuery": "閻羅降臨"
    },
    {
      "bookSourceName": "咚漫漫画（网页）",
